// prisma/schema.prisma
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum ProductStatus {
  PENDING
  PUBLISHED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  avatar    String?
  phone     String?
  address   String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  adminProfile    AdminProfile?
  profile         Profile?
  reviews         Review[]
  addresses       Address[]
  categories      Category[]         @relation("CategoryCreator")
  chatMessages    ChatMessage[]
  articles        Article[]
  articleComments ArticleComment[]
  orders          Order[]
  rewardDispatches RewardDispatch[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

// ============================================
// CHAT MESSAGE MODEL
// ============================================
model ChatMessage {
  id             String   @id @default(cuid())
  userId         String
  conversationId String
  userMessage    String   @db.Text
  botResponse    String   @db.Text
  timestamp      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([conversationId])
  @@index([timestamp])
  @@map("chat_messages")
}

// ============================================
// UNIFIED PROFILE MODEL
// ============================================
model Profile {
  id         String  @id @default(cuid())
  userId     String  @unique
  shopName   String?
  shopDesc   String?
  logo       String?
  phone      String?
  isVerified Boolean @default(false)
  totalSales Int     @default(0)
  address    String?
  banner     String?

  // Admin-specific fields
  isAdmin     Boolean   @default(false)
  adminRole   String?
  permissions String[]
  lastLogin   DateTime?
  status      String    @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model AdminProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  permissions String[]
  department  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  icon        String?
  color       String?
  parentId    String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  creator     User?      @relation("CategoryCreator", fields: [createdBy], references: [id])
  products    Product[]
  subProducts Product[]  @relation("ProductSubCategory")

  @@map("categories")
}

model Product {
  id                String   @id @default(cuid())
  // Optional side/add-on products linked to this main product
  sideProductLinks  ProductSide[] @relation("MainProductSides")
  sideOfLinks       ProductSide[] @relation("SideProductLink")
  sizesList         ProductSize[]
  rewardRules       RewardRule[]
  name              String
  slug              String   @unique
  description       String   @db.Text
  price             Decimal  @db.Decimal(10, 2)
  currency          String   @default("ETB")
  // ✅ Multi-currency prices: [{ "currency": "ETB", "amount": 1500 }, ...]
  prices            Json?
  discountPrice     Decimal? @db.Decimal(10, 2)
  // ✅ Multi-currency discount prices: [{ "currency": "ETB", "amount": 1200 }, ...]
  discountPrices    Json?
  stock             Int      @default(0)
  // ✅ Inventory availability status
  availabilityStatus String   @default("AVAILABLE") // AVAILABLE | OUT_OF_STOCK_TEMPORARY
  outOfStockAt      DateTime?
  autoRestock       Boolean  @default(true)
  restockAfterDays  Int      @default(2)
  restockQuantity   Int      @default(10)
  sku               String   @unique
  images            String[]
  categoryId        String
  subCategoryId     String?
  tags              String[]
  warranty          String?
  videoUrl          String?
  unitOfMeasurement String   @default("pcs")
  sizes             String?
  colors            String?
  brand             String?
  weight            Float?
  estimatedDelivery String?
  durationTime      String?  @default("1h")
  pricePerUnit      Decimal? @db.Decimal(10, 2)
  // ✅ Stock & arrival countdown: upcoming availability, restock, and sale end
  availableAt       DateTime?
  restockDate       DateTime?
  saleEndDate       DateTime?
  // ✅ Approval workflow: new products start PENDING until an admin publishes them
  status            ProductStatus @default(PUBLISHED)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category    Category    @relation(fields: [categoryId], references: [id])
  subCategory Category?   @relation("ProductSubCategory", fields: [subCategoryId], references: [id])
  reviews     Review[]
  orderItems  OrderItem[]

  @@index([categoryId])
  @@index([sku])
  @@map("products")
}

// ============================================
// PRODUCT SIDE / ADD-ON PRODUCTS
// ============================================
model ProductSide {
  id            String   @id @default(cuid())
  mainProductId String
  sideProductId String
  // Optional bundle price override for this pairing (null = use side product's own price)
  bundlePrice   Decimal? @db.Decimal(10, 2)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  mainProduct Product @relation("MainProductSides", fields: [mainProductId], references: [id], onDelete: Cascade)
  sideProduct Product @relation("SideProductLink", fields: [sideProductId], references: [id], onDelete: Cascade)

  @@unique([mainProductId, sideProductId])
  @@index([mainProductId])
  @@map("product_sides")
}

// ============================================
// PRODUCT SIZE VARIANTS (per-size stock)
// ============================================
model ProductSize {
  id        String  @id @default(cuid())
  productId String
  size      String
  stock     Int     @default(0)
  sku       String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size])
  @@index([productId])
  @@map("product_sizes")
}

// ============================================
// LOYALTY & REWARD RULES
// ============================================
model RewardRule {
  id           String   @id @default(cuid())
  name         String
  description  String?  @db.Text
  // Scope: PRODUCT = tied to a specific product, ALL_ORDERS = store-wide
  scope        String   @default("ALL_ORDERS")
  productId    String?
  // Trigger: MIN_QUANTITY = units bought, MIN_SPEND = amount spent
  triggerType  String   @default("MIN_SPEND")
  // Threshold value (quantity or currency amount)
  threshold    Decimal  @default(0) @db.Decimal(12, 2)
  // Legacy cumulative-spend threshold (kept for backward compatibility)
  minSpend     Decimal? @db.Decimal(12, 2)
  // FIXED_CASHBACK | PERCENT_DISCOUNT | FREE_ITEM | CUSTOM
  rewardType   String   @default("FIXED_CASHBACK")
  // Reward value: ETB amount, percent, free item name, or custom text
  rewardValue  String
  // Optional promo code granted by this rule (auto-created in promo_codes)
  promoCode    String?
  expiresAt    DateTime?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product     Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  dispatches  RewardDispatch[]
  qualifiedOrders Order[]     @relation("OrderQualifiedRule")

  @@index([active])
  @@index([productId])
  @@map("reward_rules")
}

// ============================================
// REWARD DISPATCH AUDIT LOG (SMS / Email)
// ============================================
model RewardDispatch {
  id          String    @id @default(cuid())
  rewardRuleId String?
  userId      String?
  orderId     String?
  // Recipient contact
  recipientEmail String?
  recipientPhone String?
  channel     String    // SMS | EMAIL | BOTH
  status      String    @default("PENDING") // PENDING | SENT | FAILED | REDEEMED
  message     String?   @db.Text
  error       String?   @db.Text
  sentAt      DateTime?
  sentBy      String?   // admin user id
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rewardRule RewardRule? @relation(fields: [rewardRuleId], references: [id], onDelete: SetNull)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  order      Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orderId])
  @@index([status, createdAt])
  @@map("reward_dispatches")
}

// ============================================
// AIRTIME VOUCHERS (manual PIN pool for MOBILE_AIRTIME rewards)
// ============================================
model AirtimeVoucher {
  id             String    @id @default(cuid())
  // Face value in ETB
  amount         Decimal   @db.Decimal(10, 2)
  pinCode        String
  // e.g. Ethio Telecom / Safaricom / Telebirr
  network        String?
  // AVAILABLE | USED
  status         String    @default("AVAILABLE")
  assignedOrderId String?
  usedAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, amount])
  @@map("airtime_vouchers")
}

// ============================================
// PROMO CODES (checkout redemption)
// ============================================
model PromoCode {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  // PERCENT | FIXED
  discountType   String    @default("PERCENT")
  discountValue  Decimal   @db.Decimal(12, 2)
  minOrderTotal  Decimal?  @db.Decimal(12, 2)
  active         Boolean   @default(true)
  expiresAt      DateTime?
  usageLimit     Int?
  usedCount      Int       @default(0)
  // Link back to the reward rule that generated this code (optional)
  rewardRuleId   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([active])
  @@map("promo_codes")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String      @db.Text
  note            String?     @db.Text
  paymentMethod   String      @default("CASH_ON_DELIVERY")
  paymentProofUrl String?
  status          OrderStatus @default(PENDING)
  total           Decimal     @db.Decimal(12, 2)

  // Linked customer account (for loyalty/spend tracking)
  userId          String?
  // Promo / reward code applied at checkout
  promoCode       String?
  discountAmount  Decimal     @default(0) @db.Decimal(12, 2)

  // Delivery fee & geolocation
  deliveryFee       Decimal?  @db.Decimal(10, 2)
  deliveryDistanceKm Float?
  customerLat       Float?
  customerLng       Float?
  deliveryMapsUrl   String?
  // Verified GPS & reverse-geocoded delivery details
  gpsAccuracy       Float?
  geoAddress        String?   @db.Text
  landmark          String?
  deliveryVerified  Boolean   @default(false)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  items   OrderItem[]
  rewardDispatches RewardDispatch[]
  // Reward rule this order qualified for (auto-evaluated at checkout)
  rewardQualified   Boolean     @default(false)
  qualifiedRule   RewardRule? @relation("OrderQualifiedRule", fields: [qualifiedRuleId], references: [id], onDelete: SetNull)
  qualifiedRuleId String?
  // Delivery region selected at checkout (fallback when GPS unavailable)
  deliveryRegion   DeliveryRegion? @relation(fields: [deliveryRegionId], references: [id], onDelete: SetNull)
  deliveryRegionId String?

  @@index([status, createdAt])
  @@index([customerEmail])
  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  sku         String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ============================================
// ARTICLE MODELS
// ============================================
model Article {
  id            String   @id @default(cuid())
  title         String
  titleAm       String?
  slug          String   @unique
  description   String   @db.Text
  descriptionAm String?  @db.Text
  content       String   @db.Text
  contentAm     String?  @db.Text
  category      String   @default("general")
  image         String?
  videoUrl      String?
  pdfUrl        String?
  note          String?  @db.Text
  noteAm        String?  @db.Text
  published     Boolean  @default(false)
  views       Int      @default(0)
  authorId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author   User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  comments ArticleComment[]

  @@index([published, createdAt])
  @@index([category])
  @@map("articles")
}

model ArticleCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  nameAm    String?
  slug      String   @unique
  parentId  String?
  createdAt DateTime @default(now())

  parent   ArticleCategory?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children ArticleCategory[] @relation("CategoryChildren")

  @@index([parentId])
  @@map("article_categories")
}

model ArticleComment {
  id          String   @id @default(cuid())
  articleId   String
  userId      String?
  name        String
  message     String   @db.Text
  imageUrl    String?
  pdfUrl      String?
  status      String   @default("PENDING") // PENDING | APPROVED | HIDDEN
  reply       String?  @db.Text
  repliedAt   DateTime?
  repliedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([articleId, status, createdAt])
  @@index([status, createdAt])
  @@map("article_comments")
}

model Review {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  rating      Int      @default(5)
  comment     String?  @db.Text
  imageUrl    String?
  status      String   @default("PENDING") // PENDING | APPROVED | HIDDEN
  reply       String?  @db.Text
  repliedAt   DateTime?
  repliedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([productId, status])
  @@index([status, createdAt])
  @@map("reviews")
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  fullName  String
  phone     String
  street    String
  city      String
  state     String
  zip       String
  country   String  @default("Ethiopia")
  isDefault Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ============================================
// DELIVERY REGIONS (admin-managed delivery areas & fees)
// ============================================
model DeliveryRegion {
  id        String   @id @default(cuid())
  name      String
  country   String?
  // Flat delivery fee for this region (ETB)
  fee       Decimal  @default(0) @db.Decimal(10, 2)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([active])
  @@map("delivery_regions")
}

// ============================================
// SETTINGS MODEL
// ============================================
model Settings {
  id                   String  @id @default(cuid())
  siteName             String  @default("Dream More Affiliate Market")
  siteDescription      String? @default("Discover trusted products and great deals.")
  adminEmail           String  @default("admin@alemayehplastic.com")
  adminPhone           String? @default("+251 900 000 000")
  address              String? @default("Bahir Dar, Ethiopia")
  timezone             String  @default("Africa/Addis_Ababa")
  dateFormat           String  @default("MM/DD/YYYY")
  storeName            String  @default("Dream More Affiliate Market")
  storeEmail           String  @default("info@alemayehplastic.com")
  storePhone           String? @default("+251 900 000 000")
  storeAddress         String? @default("Bahir Dar, Ethiopia")
  currency             String  @default("ETB")
  taxRate              Float   @default(15)
  logo                 String? @default("")
  favicon              String? @default("")
  twoFactorAuth        Boolean @default(false)
  sessionTimeout       Int     @default(60)
  emailNotifications   Boolean @default(true)
  orderNotifications   Boolean @default(true)
  productNotifications Boolean @default(true)
  userNotifications    Boolean @default(true)
  marketingEmails      Boolean @default(false)
  themeColor           String  @default("#e0a83c")
  darkMode             Boolean @default(false)

  // Store origin coordinates for distance-based delivery pricing
  storeLatitude     Float?
  storeLongitude    Float?
  deliveryBaseFee   Float   @default(0)
  deliveryPerKmRate Float   @default(0)
  // Distance tiers: [{ "minKm": 0, "maxKm": 5, "fee": 50 }, ...]
  deliveryTiers     Json?
  freeDeliveryAbove Float?
  // Maximum allowed delivery radius from store origin (km)
  maxDeliveryRadiusKm Float? @default(30)

  contactEmail      String? @default("support@alemayehplastic.com")
  contactPhone      String? @default("+251 900 000 000")
  contactAddress    String? @default("Bahir Dar, Ethiopia")
  contactHours      String? @default("Mon-Sat: 8:00 AM - 6:00 PM")
  contactMapEmbed   String? @default("")
  enableContactForm Boolean @default(true)
  enableWhatsApp    Boolean @default(true)
  whatsAppNumber    String? @default("+251900000000")
  enableLiveChat    Boolean @default(false)
  emergencyPhone    String? @default("+251 900 000 000")
  supportEmail      String? @default("support@alemayehplastic.com")
  infoEmail         String? @default("info@alemayehplastic.com")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}