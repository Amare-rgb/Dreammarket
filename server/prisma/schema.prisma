// prisma/schema.prisma
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  avatar    String?
  phone     String?
  address   String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  adminProfile AdminProfile?
  profile      Profile?
  reviews      Review[]
  addresses    Address[]
  categories   Category[]    @relation("CategoryCreator")
  chatMessages ChatMessage[]
  articles     Article[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

// ============================================
// CHAT MESSAGE MODEL
// ============================================
model ChatMessage {
  id             String   @id @default(cuid())
  userId         String
  conversationId String
  userMessage    String   @db.Text
  botResponse    String   @db.Text
  timestamp      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([conversationId])
  @@index([timestamp])
  @@map("chat_messages")
}

// ============================================
// UNIFIED PROFILE MODEL
// ============================================
model Profile {
  id         String  @id @default(cuid())
  userId     String  @unique
  shopName   String?
  shopDesc   String?
  logo       String?
  phone      String?
  isVerified Boolean @default(false)
  totalSales Int     @default(0)
  address    String?
  banner     String?

  // Admin-specific fields
  isAdmin     Boolean   @default(false)
  adminRole   String?
  permissions String[]
  lastLogin   DateTime?
  status      String    @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model AdminProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  permissions String[]
  department  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  icon        String?
  color       String?
  parentId    String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  creator     User?      @relation("CategoryCreator", fields: [createdBy], references: [id])
  products    Product[]
  subProducts Product[]  @relation("ProductSubCategory")

  @@map("categories")
}

model Product {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  description       String   @db.Text
  price             Decimal  @db.Decimal(10, 2)
  currency          String   @default("ETB")
  // ✅ Multi-currency prices: [{ "currency": "ETB", "amount": 1500 }, ...]
  prices            Json?
  discountPrice     Decimal? @db.Decimal(10, 2)
  stock             Int      @default(0)
  sku               String   @unique
  images            String[]
  categoryId        String
  subCategoryId     String?
  tags              String[]
  warranty          String?
  videoUrl          String?
  unitOfMeasurement String   @default("pcs")
  sizes             String?
  colors            String?
  brand             String?
  weight            Float?
  estimatedDelivery String?
  durationTime      String?  @default("1h")
  pricePerUnit      Decimal? @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category    Category    @relation(fields: [categoryId], references: [id])
  subCategory Category?   @relation("ProductSubCategory", fields: [subCategoryId], references: [id])
  reviews     Review[]
  orderItems  OrderItem[]

  @@index([categoryId])
  @@index([sku])
  @@map("products")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String      @db.Text
  note            String?     @db.Text
  paymentMethod   String      @default("CASH_ON_DELIVERY")
  paymentProofUrl String?
  status          OrderStatus @default(PENDING)
  total           Decimal     @db.Decimal(12, 2)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items OrderItem[]

  @@index([status, createdAt])
  @@index([customerEmail])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  sku         String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ============================================
// ARTICLE MODELS
// ============================================
model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  content     String   @db.Text
  category    String   @default("general")
  image       String?
  videoUrl    String?
  note        String?  @db.Text
  published   Boolean  @default(false)
  views       Int      @default(0)
  authorId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author   User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  comments ArticleComment[]

  @@index([published, createdAt])
  @@index([category])
  @@map("articles")
}

model ArticleCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  @@map("article_categories")
}

model ArticleComment {
  id        String   @id @default(cuid())
  articleId String
  name      String
  message   String   @db.Text
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
  @@map("article_comments")
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@map("reviews")
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  fullName  String
  phone     String
  street    String
  city      String
  state     String
  zip       String
  country   String  @default("Ethiopia")
  isDefault Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ============================================
// SETTINGS MODEL
// ============================================
model Settings {
  id                   String  @id @default(cuid())
  siteName             String  @default("Dream More Affiliate Market")
  siteDescription      String? @default("Discover trusted products and great deals.")
  adminEmail           String  @default("admin@alemayehplastic.com")
  adminPhone           String? @default("+251 900 000 000")
  address              String? @default("Bahir Dar, Ethiopia")
  timezone             String  @default("Africa/Addis_Ababa")
  dateFormat           String  @default("MM/DD/YYYY")
  storeName            String  @default("Dream More Affiliate Market")
  storeEmail           String  @default("info@alemayehplastic.com")
  storePhone           String? @default("+251 900 000 000")
  storeAddress         String? @default("Bahir Dar, Ethiopia")
  currency             String  @default("ETB")
  taxRate              Float   @default(15)
  logo                 String? @default("")
  favicon              String? @default("")
  twoFactorAuth        Boolean @default(false)
  sessionTimeout       Int     @default(60)
  emailNotifications   Boolean @default(true)
  orderNotifications   Boolean @default(true)
  productNotifications Boolean @default(true)
  userNotifications    Boolean @default(true)
  marketingEmails      Boolean @default(false)
  themeColor           String  @default("#e0a83c")
  darkMode             Boolean @default(false)

  contactEmail      String? @default("support@alemayehplastic.com")
  contactPhone      String? @default("+251 900 000 000")
  contactAddress    String? @default("Bahir Dar, Ethiopia")
  contactHours      String? @default("Mon-Sat: 8:00 AM - 6:00 PM")
  contactMapEmbed   String? @default("")
  enableContactForm Boolean @default(true)
  enableWhatsApp    Boolean @default(true)
  whatsAppNumber    String? @default("+251900000000")
  enableLiveChat    Boolean @default(false)
  emergencyPhone    String? @default("+251 900 000 000")
  supportEmail      String? @default("support@alemayehplastic.com")
  infoEmail         String? @default("info@alemayehplastic.com")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}