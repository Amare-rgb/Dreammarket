# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (PostgreSQL) ───────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/dreammar?schema=public"

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Frontend URL (used in emails & CORS) ────────────────
FRONTEND_URL=http://localhost:3000

# ── Email delivery (Edit Smarter newsletter, order emails)
# Option A: Resend (recommended) — https://resend.com
RESEND_API_KEY=
RESEND_FROM="Edit Smarter <newsletter@yourdomain.com>"
# Option B: SMTP fallback (e.g. Gmail / Brevo / Nodemailer)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Edit Smarter <newsletter@yourdomain.com>"

# ── Support contact shown in emails ─────────────────────
SUPPORT_EMAIL=support@alemayehplastic.com
