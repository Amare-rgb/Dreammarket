# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (PostgreSQL) ───────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/dreammar?schema=public"

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Frontend URL (used in emails & CORS) ────────────────
FRONTEND_URL=http://localhost:3000

# ── Email delivery (Edit Smarter newsletter, order emails)
# Option A: Resend (recommended) — https://resend.com
RESEND_API_KEY=
RESEND_FROM="Edit Smarter <newsletter@yourdomain.com>"
# Option B: SMTP fallback (e.g. Gmail / Brevo / Nodemailer)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Edit Smarter <newsletter@yourdomain.com>"

# ── Support contact shown in emails ─────────────────────
SUPPORT_EMAIL=support@alemayehplastic.com

# ── Google Maps (admin location picker + customer maps) ──
# Browser key — restrict by HTTP referrer in Google Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server key (optional, for geocoding/places on backend)
GOOGLE_MAPS_API_KEY=

# ── Payment provider verification (/api/payments/verify) ─
# mock | chapa | telebirr  (mock accepts refs starting with MOCK-OK-)
PAYMENT_PROVIDER=mock
CHAPA_SECRET_KEY=
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=

# ── Affiliate commissions ───────────────────────────────
# Percent of order total credited to the referrer's wallet on PAID orders (0 = off)
AFFILIATE_COMMISSION_RATE=0

# ── Admin alerts (payment verification requests) ────────
ADMIN_EMAIL=
ADMIN_ALERT_EMAIL=
# Telegram bot alerts — reuse TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID if set
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
