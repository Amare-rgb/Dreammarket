# ── Smart Editor configuration ──────────────────────────────
# Path to ffmpeg binary (must be on PATH or set explicitly)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Silence detection (ffmpeg silencedetect)
# noise floor in dB, min silence duration in seconds
SILENCE_NOISE=-35dB
SILENCE_MIN_DURATION=0.6
# merge silence gaps shorter than this into one cut
SILENCE_MERGE_GAP=0.3
# keep this much audio padding around each cut (seconds)
SILENCE_PADDING=0.08

# Scene / highlight detection (ffmpeg scene score threshold 0-1)
SCENE_THRESHOLD=0.35
# mark segments between scene changes longer than X as B-roll candidates
HIGHLIGHT_MIN_DURATION=4

# Transcription — pick ONE provider:
#   openai  → uses OPENAI_API_KEY + whisper-1 (best quality, paid)
#   whispercpp → uses WHISPER_CLI path to a local whisper.cpp binary
#   none    → skip transcription, captions will be empty
TRANSCRIBE_PROVIDER=none
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1
WHISPER_CLI=
WHISPER_MODEL=base

# Output
OUTPUT_DIR=./out
